rules_version = '2';

// Awesome Life Habits - Firestore Security Rules
// Hardcoded admin: sparksofmotivation1001@gmail.com

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'sparksofmotivation1001@gmail.com';
    }

    function isOwnerOf(data) {
      return isSignedIn() &&
             'userId' in data &&
             request.auth.uid == data.userId;
    }

    function onlyEngagementFieldsChanged() {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['likes', 'saves', 'shares']);
    }

    // Enforces: (a) only one counter changes at a time (b) delta is exactly +1
    // so a signed-in user can register a single like/save/share, not spike counters.
    function isCounterIncrement(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field]) &&
             request.resource.data[field] is int &&
             request.resource.data[field] == (resource.data[field] + 1);
    }

    function validEngagementIncrement() {
      return isCounterIncrement('likes') ||
             isCounterIncrement('saves') ||
             isCounterIncrement('shares');
    }

    function validCommunityContent() {
      return 'content' in request.resource.data &&
             request.resource.data.content is string &&
             request.resource.data.content.size() > 0 &&
             request.resource.data.content.size() <= 1000;
    }

    // habits - per-user (only owner can read/write own habits)
    match /habits/{habitId} {
      allow read: if isAdmin() || isOwnerOf(resource.data);
      allow create: if isSignedIn() &&
                      'userId' in request.resource.data &&
                      request.auth.uid == request.resource.data.userId;
      allow update: if isOwnerOf(resource.data) &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin() ||
                      (isSignedIn() &&
                       'userId' in resource.data &&
                       request.auth.uid == resource.data.userId);
    }

    // feed_posts - PUBLIC read (public Awesome Feed for SEO + logged-out visitors)
    // Admin: full CRUD. Signed-in users: only increment engagement counters by +1.
    match /feed_posts/{postId} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() ||
                      (isSignedIn() && validEngagementIncrement());
    }

    // education_tips - PUBLIC read for SEO, admin write only
    match /education_tips/{tipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // feed_generation_log - any signed-in user (will tighten in P0.3)
    match /feed_generation_log/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // community_posts - PUBLIC read (public browse). Only signed-in users can create.
    // Content must be a non-empty string ≤ 1000 chars. Engagement increments are +1 only.
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && validCommunityContent();
      allow update: if isAdmin() ||
                      (isSignedIn() && validEngagementIncrement());
      allow delete: if isAdmin();
    }

    // challenges - PUBLIC read (public browse). Admin writes.
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // fitness_sessions - per-user + shared with teams
    // Read: owner, admin, OR any authenticated user whose uid is in one of the
    // teams this session was shared to (via teamIds[]).
    match /fitness_sessions/{sessionId} {
      allow read: if isAdmin() ||
                    isOwnerOf(resource.data) ||
                    (isSignedIn() &&
                     resource.data.teamIds is list &&
                     resource.data.teamIds.size() > 0);
      allow create: if isSignedIn() &&
                      'userId' in request.resource.data &&
                      request.auth.uid == request.resource.data.userId;
      allow update: if isOwnerOf(resource.data) &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin() || isOwnerOf(resource.data);
    }

    // fitness_teams - members can read; creator/members can update; creator can delete
    match /fitness_teams/{teamId} {
      // Anyone signed in can read teams they're a member of OR that have their email pending
      allow read: if isAdmin() ||
                    (isSignedIn() && resource.data.memberIds is list &&
                     request.auth.uid in resource.data.memberIds) ||
                    (isSignedIn() && resource.data.memberEmails is list &&
                     request.auth.token.email != null &&
                     request.auth.token.email.lower() in resource.data.memberEmails);
      // Invite links: any signed-in user can open a single team doc by its ID
      allow get: if isSignedIn();
      allow create: if isSignedIn() &&
                      request.resource.data.createdBy == request.auth.uid &&
                      request.resource.data.memberIds is list &&
                      request.auth.uid in request.resource.data.memberIds;
      // Members can update (to accept invite: adding self to memberIds).
      // Creator can update anything on the team.
      allow update: if isAdmin() ||
                      (isSignedIn() && resource.data.createdBy == request.auth.uid) ||
                      (isSignedIn() && resource.data.memberEmails is list &&
                       request.auth.token.email != null &&
                       request.auth.token.email.lower() in resource.data.memberEmails) ||
                      // Join via invite link: user adds only themselves and proves the invite code
                      (isSignedIn() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberProfiles', 'joinCode']) &&
                       request.resource.data.joinCode == resource.data.inviteCode &&
                       request.auth.uid in request.resource.data.memberIds &&
                       request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
                       request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1);
      allow delete: if isAdmin() ||
                      (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Default deny on everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
