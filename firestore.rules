rules_version = '2';

// Awesome Life Habits - Firestore Security Rules
// Hardcoded admin: sparksofmotivation1001@gmail.com

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'sparksofmotivation1001@gmail.com';
    }

    function isOwnerOf(data) {
      return isSignedIn() &&
             'userId' in data &&
             request.auth.uid == data.userId;
    }

    function onlyEngagementFieldsChanged() {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['likes', 'saves', 'shares']);
    }

    // habits - per-user (only owner can read/write own habits)
    match /habits/{habitId} {
      allow read: if isAdmin() || isOwnerOf(resource.data);
      allow create: if isSignedIn() &&
                      'userId' in request.resource.data &&
                      request.auth.uid == request.resource.data.userId;
      allow update: if isOwnerOf(resource.data) &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin() ||
                      (isSignedIn() &&
                       'userId' in resource.data &&
                       request.auth.uid == resource.data.userId);
    }

    // feed_posts - any signed-in user can read
    // Admin: full CRUD. Other users: only update engagement counters.
    match /feed_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() ||
                      (isSignedIn() && onlyEngagementFieldsChanged());
    }

    // education_tips - PUBLIC read for SEO, admin write only
    match /education_tips/{tipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // feed_generation_log - any signed-in user (will tighten in P0.3)
    match /feed_generation_log/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // community_posts - any signed-in user can read & create
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() ||
                      (isSignedIn() && onlyEngagementFieldsChanged());
      allow delete: if isAdmin();
    }

    // challenges - any signed-in user can read, admin writes
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Default deny on everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
